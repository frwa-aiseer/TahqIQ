# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server-only model routing. Change model IDs here without editing feature code.
TEHQIQ_MODEL_FAST="gemini-3.6-flash"
TEHQIQ_MODEL_MAIN="gemini-3.6-flash"
TEHQIQ_MODEL_REVIEW="gemini-3.6-flash"

# Required versioned pricing configuration for budget enforcement. Supply
# deployment-approved provider/model input and output USD-per-million-token
# entries; commercial prices are intentionally not embedded in application code.
# Schema: {"version":"...","effectiveAt":"ISO-8601","entries":[{"provider":"...","model":"...","inputUsdPerMillionTokens":0,"outputUsdPerMillionTokens":0}]}
TEHQIQ_AI_PRICING_CONFIG_JSON=
# Server default used unless the trusted project document contains aiBudgetPolicy.
TEHQIQ_AI_BUDGET_POLICY_JSON='{"softLimitUsd":10,"hardLimitUsd":20,"maxProviderCallsPerRequest":2,"maxAgentLoopIterations":3,"minimumRemainingUsdByTier":{"REVIEW":2}}'
TEHQIQ_AI_MAX_OUTPUT_TOKENS=4096

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Web client configuration. These are public client identifiers, not
# Firebase Admin credentials or service-account secrets. Leave blank to run in
# the explicit safe "Not Configured" state.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only Firebase Admin project identifier. Authentication uses Application
# Default Credentials supplied by the deployment environment; never expose
# service-account JSON or private keys through a VITE_* variable.
FIREBASE_ADMIN_PROJECT_ID=
# Optional server-side self-hosted/Cloud Run Docling-compatible parser base URL.
# Never expose this as a VITE_ variable. When absent, rich documents remain Not Configured.
DOCUMENT_PARSER_SERVICE_URL=

# Optional server-side Whisper-compatible/self-hosted transcription base URL.
# A privacy-routing hook must also authorize each request before bytes are sent.
TRANSCRIPTION_SERVICE_URL=

# Optional server-side open/local model endpoints. These are HTTP service
# adapters; models do not run in the browser. A configured endpoint must pass
# its /health check before routing. Never expose endpoints or keys as VITE_*.
# Privacy mode may be Standard Cloud, Private/Hybrid, or Local-Only. Existing
# projects without an aiPrivacyMode field use this server default.
TEHQIQ_AI_PRIVACY_MODE="Standard Cloud"
TEHQIQ_SCIENTIFIC_EMBEDDING_ENDPOINT=
TEHQIQ_SCIENTIFIC_EMBEDDING_MODEL="SPECTER2-compatible"
TEHQIQ_SCIENTIFIC_EMBEDDING_API_KEY=
TEHQIQ_GENERAL_EMBEDDING_ENDPOINT=
TEHQIQ_GENERAL_EMBEDDING_MODEL="BGE-M3-compatible"
TEHQIQ_GENERAL_EMBEDDING_API_KEY=
TEHQIQ_WHISPER_ENDPOINT=
TEHQIQ_WHISPER_MODEL="Whisper-compatible"
TEHQIQ_WHISPER_API_KEY=
TEHQIQ_VISION_DOCUMENT_ENDPOINT=
TEHQIQ_VISION_DOCUMENT_MODEL="Qwen-VL-compatible"
TEHQIQ_VISION_DOCUMENT_API_KEY=
TEHQIQ_LOCAL_LLM_ENDPOINT=
TEHQIQ_LOCAL_LLM_MODEL="Local-general-compatible"
TEHQIQ_LOCAL_LLM_API_KEY=
# Required before the local general endpoint can route: Local or Private.
# This is an operator assertion about the endpoint trust boundary, not inferred
# from its hostname. Local-Only accepts only Local; Private/Hybrid accepts both.
TEHQIQ_LOCAL_LLM_LOCATION=
