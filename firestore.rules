rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(projectData) {
      return isSignedIn() && projectData.ownerUid == request.auth.uid;
    }
    
    function isMember(projectData) {
      return isSignedIn() && (
        projectData.ownerUid == request.auth.uid ||
        (projectData.members != null && projectData.members[request.auth.uid] != null)
      );
    }
    
    function getRole(projectData) {
      return projectData.ownerUid == request.auth.uid
        ? 'Owner'
        : (projectData.members != null && projectData.members[request.auth.uid] != null
          ? projectData.members[request.auth.uid]
          : 'Viewer');
    }
    
    function canWriteProject(projectData) {
      return isMember(projectData) && (
        getRole(projectData) in ['Owner', 'Corresponding Author', 'Co-author', 'Supervisor', 'Statistician']
      );
    }

    function hasValidOwnerMembership(projectData) {
      return projectData.ownerUid is string &&
        projectData.members is map &&
        projectData.members[projectData.ownerUid] == 'Owner';
    }

    function protectedMembershipFieldsUnchanged() {
      return request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.members == resource.data.members &&
        request.resource.data.memberList == resource.data.memberList &&
        request.resource.data.organizationId == resource.data.organizationId;
    }

    match /users/{userId} {
      allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /projects/{projectId} {
      allow read: if isMember(resource.data);
      
      allow create: if isSignedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        hasValidOwnerMembership(request.resource.data);
      
      allow update: if canWriteProject(resource.data) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        hasValidOwnerMembership(request.resource.data) &&
        (isOwner(resource.data) || protectedMembershipFieldsUnchanged());
      
      allow delete: if isSignedIn() && isOwner(resource.data);

      match /versions/{versionId} {
        allow read: if isMember(get(/databases/$(database)/documents/projects/$(projectId)).data);
        allow create: if canWriteProject(get(/databases/$(database)/documents/projects/$(projectId)).data) &&
          request.resource.data.createdByUid == request.auth.uid;
        allow update, delete: if false;
      }

      match /auditEvents/{eventId} {
        allow read: if isMember(get(/databases/$(database)/documents/projects/$(projectId)).data);
        // High-integrity history is written only by the trusted Admin SDK path,
        // which bypasses client rules after verifying actor, membership and role.
        allow create, update, delete: if false;
      }
      
      match /files/{fileId} {
        allow read: if isMember(get(/databases/$(database)/documents/projects/$(projectId)).data);
        allow create: if canWriteProject(get(/databases/$(database)/documents/projects/$(projectId)).data) &&
          request.resource.data.uploadedByUid == request.auth.uid;
        allow update: if canWriteProject(get(/databases/$(database)/documents/projects/$(projectId)).data) &&
          request.resource.data.uploadedByUid == resource.data.uploadedByUid;
        allow delete: if isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data);
      }
    }
  }
}
